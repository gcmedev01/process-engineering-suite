{
  "name": "process-engineering-suite",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel --filter='./apps/*' --filter=!calculation-template",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "check:deploy:vercel": "DEPLOY_TARGET=vercel VERCEL=1 turbo run build --filter=web --filter=network-editor --filter=psv --filter=docs",
    "check:deploy:aws": "DEPLOY_TARGET=aws turbo run build --filter=web --filter=network-editor --filter=psv --filter=docs",
    "check:deploy:matrix": "bun run check:deploy:vercel && bun run check:deploy:aws",
    "gen-types": "bun --filter @eng-suite/types generate"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "turbo": "^2.6.3",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "bun@1.3.5",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}

# AWS ECS/Fargate Deployment Environment Configuration
# This file documents variables for AWS Secrets Manager and the build script.
#
# IMPORTANT: NEXT_PUBLIC_* variables are baked into the frontend bundle at
# BUILD time by Next.js — setting them as ECS task environment variables has
# no effect. Pass them as --build-arg to build-and-push.sh instead:
#   API_URL=https://api.your-domain.com ./infra/aws/scripts/build-and-push.sh

# ── ECS / runtime variables (go into task definitions or Secrets Manager) ──

# Environment Detection
DEPLOYMENT_ENV=aws

# API runtime settings
API_HOST=0.0.0.0
API_PORT=8000

# Database Configuration (AWS RDS PostgreSQL)
# Store in AWS Secrets Manager: process-engineering/database-url
# Format: postgresql+asyncpg://username:password@rds-endpoint:5432/engsuite
DATABASE_URL=<from-secrets-manager>

# API secret key
# Store in AWS Secrets Manager: process-engineering/secret-key
# Generate with: openssl rand -hex 32
SECRET_KEY=<from-secrets-manager>

# CORS: comma-separated allowed origins (your ALB / CloudFront domain)
# Store in AWS Secrets Manager: process-engineering/allowed-origins
ALLOWED_ORIGINS=<from-secrets-manager>

# AWS region (must match the region used in task definition log configs)
AWS_REGION=us-east-1

# ── Build-time variables (pass as --build-arg to build-and-push.sh) ────────
#
# API_URL  — public HTTPS URL of the API ALB or CloudFront distribution.
#            Used as NEXT_PUBLIC_API_URL and API_PROXY_TARGET during the
#            Next.js build. Without this, frontends fall back to localhost.
#
# Example:
#   API_URL=https://api.your-domain.com \
#     AWS_REGION=ap-southeast-1 \
#     ./infra/aws/scripts/build-and-push.sh

# ── Infrastructure reference (not used at runtime) ─────────────────────────
# RDS Instance: db.t3.medium recommended, Multi-AZ for production
# ECS Cluster:  process-engineering-cluster
# VPC:          Private subnets for ECS/RDS, public subnets for ALB
# ALB:          Application Load Balancer with HTTPS termination
# ECR repos:    process-engineering/{api,web,network-editor,psv,design-agents}

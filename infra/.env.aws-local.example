# Environment file for local smoke-testing the AWS production images.
# Copy to .env.aws-local and fill in values before running:
#   docker compose -f infra/docker-compose.aws-local.yml --env-file infra/.env.aws-local up

# PostgreSQL password for the local postgres container
POSTGRES_PASSWORD=change-me-local

# API secret key (any random string is fine for local testing)
SECRET_KEY=local-dev-secret-change-me

# Comma-separated CORS origins the API will accept
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003,http://localhost:3004,http://localhost:3005,http://localhost:3006,http://localhost:3007,http://localhost:3008,http://localhost:3009

# Local database host port
POSTGRES_PORT=5432

# Browser-facing API URL baked into frontend images
API_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_AUTH_API_URL=http://localhost:8000
VITE_API_URL=http://localhost:8000

# Container-internal API URL used by Next.js rewrites
API_PROXY_TARGET=http://api:8000

# Browser-facing app URLs baked into the web dashboard image
DOCS_URL=http://localhost:3001
NETWORK_EDITOR_URL=http://localhost:3002
PSV_URL=http://localhost:3003
DESIGN_AGENTS_URL=http://localhost:3004
VENTING_URL=http://localhost:3005
VESSELS_CALCULATION_URL=http://localhost:3006
PUMP_URL=http://localhost:3007
HEAT_TRANSFER_URL=http://localhost:3008
CONTROL_VALVE_URL=http://localhost:3009

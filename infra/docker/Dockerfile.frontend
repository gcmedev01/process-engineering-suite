# Multi-stage build for Next.js frontends (AWS ECS/Fargate)
# Supports building: web, docs, network-editor, psv,
#   venting-calculation, vessels-calculation, pump-calculation, heat-transfer-calculation
# Usage: docker build --build-arg APP_NAME=psv --build-arg BASE_PATH=/psv -f Dockerfile.frontend .
#
# NEXT_PUBLIC_* and proxy targets are baked at BUILD time (Next.js inlines them),
# so pass them as --build-arg, not as ECS task environment variables.

# ============================================================================
# Stage 1: Dependencies
# ============================================================================
FROM oven/bun:1 AS deps

WORKDIR /app

# Copy everything the workspace resolver needs. All workspace package.json files
# (apps/* and packages/*) must be present for `bun install --frozen-lockfile`.
COPY package.json bun.lock turbo.json ./
COPY packages ./packages
COPY apps ./apps

# Install dependencies
RUN bun install --frozen-lockfile

# ============================================================================
# Stage 2: Builder
# ============================================================================
FROM oven/bun:1 AS builder

WORKDIR /app

# Build argument for which app to build
ARG APP_NAME
ENV APP_NAME=${APP_NAME}

# Build-time API/proxy targets (Next.js inlines these at build time)
ARG NEXT_PUBLIC_API_URL
ARG API_PROXY_TARGET
ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL}
ENV API_PROXY_TARGET=${API_PROXY_TARGET}

# Copy installed dependencies and full workspace sources from deps stage
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/packages ./packages
COPY --from=deps /app/apps ./apps
COPY turbo.json package.json ./

# Build the specific app
RUN bun run build --filter=${APP_NAME}

# Ensure public dir exists so the runner stage COPY always succeeds
RUN mkdir -p /app/apps/${APP_NAME}/public

# ============================================================================
# Stage 3: Production - Standalone Next.js
# ============================================================================
FROM node:20-alpine AS runner

WORKDIR /app

# Create non-root user
RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 nextjs

# Copy standalone output
ARG APP_NAME
ENV APP_NAME=${APP_NAME}

# basePath the app is served under (e.g. /psv). Empty for the root web app.
# Used by the health check below.
ARG BASE_PATH=""
ENV BASE_PATH=${BASE_PATH}

COPY --from=builder --chown=nextjs:nodejs /app/apps/${APP_NAME}/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/apps/${APP_NAME}/.next/static ./apps/${APP_NAME}/.next/static
COPY --from=builder --chown=nextjs:nodejs /app/apps/${APP_NAME}/public ./apps/${APP_NAME}/public

USER nextjs

# Expose port (default 3000, override via environment)
EXPOSE 3000

ENV NODE_ENV=production
ENV PORT=3000
# Bind to all interfaces so health checks over localhost work inside the container
ENV HOSTNAME=0.0.0.0

# Health check — probe the app root under its basePath (returns 200).
# Hitting /api/health would be intercepted by the app's API proxy rewrite.
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
    CMD node -e "require('http').get('http://localhost:3000'+(process.env.BASE_PATH||''), (r) => {process.exit(r.statusCode === 200 ? 0 : 1)}).on('error', () => process.exit(1))"

# Start the app (use shell form for variable expansion)
CMD node apps/$APP_NAME/server.js

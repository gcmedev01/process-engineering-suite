# Multi-stage build for Vite apps (design-agents)
# Builds static assets and serves via Nginx

# ============================================================================
# Stage 1: Builder
# ============================================================================
FROM oven/bun:1 AS builder

WORKDIR /app

# Copy package files. All workspace package.json files (apps/* and packages/*)
# must be present for `bun install --frozen-lockfile`.
COPY package.json bun.lock turbo.json tsconfig.json ./
COPY packages ./packages
COPY apps ./apps

# Install dependencies
RUN bun install --frozen-lockfile

# Pre-build shared packages so Vite/Rollup can resolve their compiled entry points.
# (Vite uses Node package resolution; it needs dist/ — unlike Turbopack which handles raw TS.)
WORKDIR /app
RUN bun turbo run build --filter="./packages/*"

# Build the Vite app (vite only — tsc type check runs in CI, not here)
WORKDIR /app/apps/design-agents
ARG VITE_API_URL
ENV VITE_API_URL=${VITE_API_URL}
RUN bunx vite build

# ============================================================================
# Stage 2: Production - Nginx server
# ============================================================================
FROM nginx:alpine

# Copy built assets
COPY --from=builder /app/apps/design-agents/dist /usr/share/nginx/html/design-agents

# Copy custom Nginx config for SPA routing
COPY infra/docker/nginx.conf /etc/nginx/conf.d/default.conf

# nginx:alpine already ships an unprivileged `nginx` user/group; the master
# process must run as root to bind port 80 and drops to `nginx` for workers.

EXPOSE 80

# Health check
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://127.0.0.1:80/design-agents/ || exit 1

# Start Nginx
CMD ["nginx", "-g", "daemon off;"]

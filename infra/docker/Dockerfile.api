# Multi-stage build for Python API (AWS ECS/Fargate)
# Optimized for production deployment without PostgreSQL
#
# The API lives at services/api (NOT apps/api). Build context must be the
# repository root: docker build -f infra/docker/Dockerfile.api .

# ============================================================================
# Stage 1: Builder - Install dependencies
# ============================================================================
FROM python:3.11-slim AS builder

WORKDIR /app

# Install system dependencies for building Python packages
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements and install Python dependencies into an isolated prefix
COPY services/api/requirements.txt .
RUN pip install --no-cache-dir --user -r requirements.txt

# ============================================================================
# Stage 2: Production - Minimal runtime image
# ============================================================================
FROM python:3.11-slim

WORKDIR /app

# Install runtime dependencies only
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user before copying so we can own the package dir
RUN useradd -m -u 1000 appuser

# Copy Python packages from builder into the appuser home (readable by appuser)
COPY --from=builder --chown=appuser:appuser /root/.local /home/appuser/.local

# Copy application code (API + shared services + packages)
COPY --chown=appuser:appuser services ./services
COPY --chown=appuser:appuser packages ./packages

USER appuser

# Make sure user-installed Python packages are on PATH
ENV PATH=/home/appuser/.local/bin:$PATH
# /app for the project, calc-engine for the hydraulics engine (see HANDOFF.md)
ENV PYTHONPATH=/app:/app/services/calc-engine:/app/services/calc-engine/hydraulics

# Expose API port
EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# Run migrations from the api directory (alembic.ini uses script_location = alembic
# which resolves relative to CWD, not the ini file path).
CMD ["sh", "-c", "cd /app/services/api && alembic upgrade head && exec uvicorn services.api.main:app --host 0.0.0.0 --port 8000"]
